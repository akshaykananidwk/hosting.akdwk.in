# =====================================================================
# AK CLOUD — .env.example
# Installer (Module 1) આ file ને copy કરી `.env` બનાવે અને values ભરે.
# `.env` ક્યારેય git માં commit ન કરવો — .gitignore માં block છે.
# =====================================================================

APP_NAME="AK Cloud"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://panel.akdwk.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# ---- Encryption key (AES-256). Installer auto-generates 32-byte key ----
APP_KEY=

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=akcloud
DB_USER=akcloud
DB_PASS=
DB_CHARSET=utf8mb4

# ---- aaPanel (default local panel on this VPS) ----
AAPANEL_URL=http://127.0.0.1:35435
AAPANEL_VERIFY_SSL=false

# ---- WhatsApp gateway (defaults; overridable in Admin → Settings) ----
WHATSAPP_API_URL=https://bulk.akdwk.in/api.php

# ---- PHP binary path on aaPanel (auto-detected in installer) ----
PHP_BIN=/www/server/php/82/bin/php

# ---- Session / security ----
SESSION_SECURE=true
SESSION_SAMESITE=Lax
