# FILE: /.htaccess
# -------------------------------------------------------------------
# Apache fallback (aaPanel default Nginx છે — Nginx માટે
# nginx.conf.snippet વાપરો). બધી requests index.php પર route કરે
# અને sensitive directories block કરે.
# -------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files/directories directly (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Block access to sensitive paths.
RedirectMatch 403 ^/\.env
RedirectMatch 403 ^/config(/|$)
RedirectMatch 403 ^/app(/|$)
RedirectMatch 403 ^/storage(/|$)
RedirectMatch 403 ^/database(/|$)
RedirectMatch 403 ^/vendor-local(/|$)
RedirectMatch 403 ^/cron(/|$)

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
